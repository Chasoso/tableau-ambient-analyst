{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "blockingFindings", "nonBlockingFindings", "escalationRequired"],
  "properties": {
    "result": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUIRED", "HUMAN_DECISION_REQUIRED"]
    },
    "blockingFindings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonBlockingFindings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalationRequired": { "type": "boolean" }
  }
}
