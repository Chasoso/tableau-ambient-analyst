{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "blockingFindings", "nonBlockingFindings", "escalationRequired"],
  "properties": {
    "result": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUIRED", "HUMAN_DECISION_REQUIRED"]
    },
    "blockingFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "nonBlockingFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "escalationRequired": { "type": "boolean" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "classification", "finding", "generalized_rule", "affected_locations", "recommended_fix"],
      "properties": {
        "severity": { "type": "string", "enum": ["blocking", "non-blocking"] },
        "classification": { "type": "string", "enum": ["AUTO_FIX", "HUMAN_DECISION_REQUIRED", "BLOCKED"] },
        "finding": { "type": "string" },
        "generalized_rule": { "type": "string" },
        "affected_locations": { "type": "array", "items": { "type": "string" } },
        "recommended_fix": { "type": "string" }
      }
    }
  }
}
