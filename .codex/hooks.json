{
  "description": "Repository-local mechanical Git safety guards.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/run_pre_tool_use_policy.mjs\"",
            "statusMessage": "Checking repository safety policy"
          }
        ]
      }
    ]
  }
}
